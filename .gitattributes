# Text files are stored with LF in the repository
* text=auto
# Shell scripts must keep LF endings, otherwise bash fails with $'\r' errors
*.sh text eol=lf
# Windows scripts get CRLF in the working copy
*.ps1 text eol=crlf
*.docx binary
# Files executed inside Linux containers keep LF
*.Dockerfile text eol=lf
.dockerignore text eol=lf
compose.yaml text eol=lf
