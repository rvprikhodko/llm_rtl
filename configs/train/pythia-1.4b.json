{
  "model": "EleutherAI/pythia-1.4b",
  "revision": "step143000",
  "train_file": "dataset/filtered/train.jsonl",
  "val_file": "dataset/filtered/val.jsonl",
  "prompt_template": "### Instruction:\n{instruction}\n\n### Response:\n",
  "max_len": 2048,
  "global_batch_size": 32,
  "micro_batch_size": 4,
  "epochs": 2,
  "lr": 2e-4,
  "warmup_ratio": 0.03,
  "min_lr_ratio": 0.1,
  "weight_decay": 0.0,
  "grad_clip": 1.0,
  "lora": {
    "r": 16,
    "alpha_ratio": 2,
    "dropout": 0.05,
    "target_modules": null,
    "target_trainable_params": null
  },
  "gradient_checkpointing": true,
  "pass_attention_mask": true,
  "bf16": true,
  "save_every_tokens": 2000000,
  "save_every_gpu_seconds": 1800,
  "log_every_steps": 10,
  "seed": 0
}
